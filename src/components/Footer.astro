---
import { appInfo } from "@/lib/config";
---

<!--
  Footer component displaying version and license information
  This appears at the bottom of every page
-->
<footer class="w-full py-8 border-t border-border mt-auto">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-serif italic text-sm text-muted-foreground">
      <span>
        Monograph Edition · v{appInfo.version} ({appInfo.hash})
      </span>
      <p class="text-center text-muted-foreground/80">
        {appInfo.license.copyright}. All rights reserved.
      </p>
      <span>
        {appInfo.license.name}
      </span>
    </div>
  </div>
</footer>
