---
import { appInfo } from "@/lib/config";
---

<!--
  Footer component displaying version and license information
  This appears at the bottom of every page
-->
<footer class="w-full py-4 border-t border-border bg-secondary/70 font-mono text-xs mt-auto">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="bg-primary text-primary-foreground px-1.5 py-0.5 font-bold">TMUX</span>
        <span class="text-foreground">v{appInfo.version} ({appInfo.hash})</span>
      </div>
      <p class="text-muted-foreground text-center">
        {appInfo.license.copyright}. All rights reserved.
      </p>
      <span class="text-primary uppercase tracking-wider">
        [{appInfo.license.name}]
      </span>
    </div>
  </div>
</footer>
